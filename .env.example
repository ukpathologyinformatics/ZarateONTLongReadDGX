export SNIFFLES_SCRIPT="run_sniffles.sh"
export NEEDLR_SCRIPT="run_needlr.sh"
export MOSDEPTH_SCRIPT="run_mosdepth.sh"
export SPECTRE_SCRIPT="run_spectre.sh"
