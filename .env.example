export MAHIMAHI_IMAGE="python:3.12-trixie"
export SNIFFLES_IMAGE="quay.io\#biocontainers/sniffles:2.8.0--pyhdfd78af_1"
export NEEDLR_IMAGE="miragale/needlr:latest"
export MOSDEPTH_IMAGE="quay.io\#biocontainers/mosdepth:0.3.14--h87be163_2"
export SPECTRE_IMAGE="ontresearch/spectre:sha42472d37a5a992c3ee27894a23dce5e2fff66d27"
export MODKIT_IMAGE="ontresearch/modkit:latest"

# SquashFS Files
export DORADO_SQFS_FILE=""
export SAMTOOLS_SQFS_FILE=""
export CLAIR3_SQFS_FILE=""
export MAHIMAHI_SQFS_FILE=""
export SNIFFLES_SQFS_FILE=""
export NEEDLR_SQFS_FILE=""
export MOSDEPTH_SQFS_FILE=""
